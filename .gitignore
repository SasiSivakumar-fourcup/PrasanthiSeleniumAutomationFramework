# ==============================================================================
#  What must never reach GitHub
# ==============================================================================

# --- Build output -------------------------------------------------------------
target/
bin/
out/
*.class
*.jar
*.war

# --- Generated by a run (regenerated every time - keeping them causes conflicts)
test-output/
logs/
downloads/
screenshots/
*.log
allure-results/

# --- IDE ----------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/
.metadata/

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- SECRETS - the important section -----------------------------------------
# Real credentials belong in environment variables or the Jenkins credential
# store. ConfigManager reads environment variables ahead of the properties file
# precisely so this stays true.
config-local.properties
config-secret.properties
*.pem
*.p12
*.jks
.env
secrets/

# --- Selenium / driver leftovers ----------------------------------------------
# Selenium Manager downloads drivers into ~/.cache/selenium. If an old habit
# leaves a binary here, do not commit it - it is OS-specific and goes stale.
chromedriver*
geckodriver*
msedgedriver*
operadriver*
selenium-server*.jar
